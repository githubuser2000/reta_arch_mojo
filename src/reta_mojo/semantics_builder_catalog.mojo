def bootstrap_parameter_semantics_schema() -> ParameterSemanticsSchema:
    var entries = List[ParameterMatrixEntry]()
    _append_parameter_entries_00(entries)
    _append_parameter_entries_01(entries)
    _append_parameter_entries_02(entries)
    _append_parameter_entries_03(entries)
    _append_parameter_entries_04(entries)
    _append_parameter_entries_05(entries)
    _append_parameter_entries_06(entries)
    _append_parameter_entries_07(entries)
    _append_parameter_entries_08(entries)
    _append_parameter_entries_09(entries)
    _append_parameter_entries_10(entries)
    _append_parameter_entries_11(entries)
    _append_parameter_entries_12(entries)
    _append_parameter_entries_13(entries)
    _append_parameter_entries_14(entries)
    _append_parameter_entries_15(entries)
    _append_parameter_entries_16(entries)
    _append_parameter_entries_17(entries)
    var combinations1 = List[CombinationEntry]()
    _append_combinations_1(combinations1)
    var combinations2 = List[CombinationEntry]()
    _append_combinations_2(combinations2)
    return ParameterSemanticsSchema(entries^, combinations1^, combinations2^)


def bootstrap_full_parameter_semantics(invert_alles: Bool = False) raises -> ParameterSemanticsBuildResult:
    return build_parameter_semantics(
        bootstrap_parameter_semantics_schema(),
        24,
        invert_alles,
        ["alles"],
    )
