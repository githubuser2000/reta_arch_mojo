"""Generated native Mojo representation of architecture_rehearsal.
The Python reference is evaluated only during explicit regeneration; runtime
navigation and snapshot validation are fully native.
Regenerate with tools/generate_architecture_rehearsal.py.
"""

from std.collections import List

@fieldwise_init
struct RehearsalCommandSpec(Copyable):
    var name: String
    var command: String

@fieldwise_init
struct RehearsalOpenSetSpec(Copyable):
    var open_set_id: String
    var wave_id: String
    var order: Int
    var name: String
    var owner_capsules: List[String]
    var candidates: List[String]
    var basis: List[String]
    var topology_role: String
    var status: String

@fieldwise_init
struct RehearsalMoveSpec(Copyable):
    var move_id: String
    var step_id: String
    var wave_id: String
    var legacy_owner: String
    var target_owner: String
    var current_capsule: String
    var target_capsule: String
    var action_type: String
    var category: String
    var functors: List[String]
    var natural_transformations: List[String]
    var diagrams: List[String]
    var laws: List[String]
    var gates: List[String]
    var preconditions: List[String]
    var postconditions: List[String]
    var rollback_anchor: String
    var status: String

@fieldwise_init
struct GateRehearsalSpec(Copyable):
    var gate_suite_id: String
    var step_id: String
    var candidate: String
    var gates: List[String]
    var preflight_commands: List[RehearsalCommandSpec]
    var postflight_commands: List[RehearsalCommandSpec]
    var rollback_anchor: String
    var command_parity_required: Bool
    var bound_diagrams: List[String]
    var status: String

@fieldwise_init
struct RehearsalCoverSpec(Copyable):
    var cover_id: String
    var open_set_id: String
    var wave_id: String
    var moves: List[String]
    var gate_suites: List[String]
    var gluing_operation: String
    var universal_property: String
    var status: String

@fieldwise_init
struct RehearsalCheckSpec(Copyable):
    var name: String
    var status: String
    var failed_items: List[String]
    var checked_count: Int
    var reading: String

@fieldwise_init
struct RehearsalValidationSpec(Copyable):
    var status: String
    var missing_migration_steps: List[String]
    var rehearsals_without_gate_suite: List[String]
    var open_sets_without_cover: List[String]
    var unknown_diagrams: List[String]
    var unknown_laws: List[String]
    var unknown_natural_transformations: List[String]
    var gate_suites_with_missing_commands: List[String]
    var checks: List[RehearsalCheckSpec]

@fieldwise_init
struct Stage35ArchitecturePlan(Copyable):
    var planned_after_stage_34: List[String]
    var implemented_in_stage_35: List[String]
    var inherited_from_previous_stages: List[String]
    var behaviour_change: String

@fieldwise_init
struct ArchitectureRehearsalBundle(Copyable):
    var open_sets: List[RehearsalOpenSetSpec]
    var moves: List[RehearsalMoveSpec]
    var gate_rehearsals: List[GateRehearsalSpec]
    var covers: List[RehearsalCoverSpec]
    var validation: RehearsalValidationSpec
    var text_diagram: String
    var mermaid_diagram: String
    var plan: Stage35ArchitecturePlan

def rehearsal_open_set_index(bundle: ArchitectureRehearsalBundle, value: String) -> Int:
    for index in range(len(bundle.open_sets)):
        if bundle.open_sets[index].open_set_id == value:
            return index
    return -1

def rehearsal_move_index(bundle: ArchitectureRehearsalBundle, value: String) -> Int:
    for index in range(len(bundle.moves)):
        if bundle.moves[index].move_id == value:
            return index
    return -1

def rehearsal_step_index(bundle: ArchitectureRehearsalBundle, value: String) -> Int:
    for index in range(len(bundle.moves)):
        if bundle.moves[index].step_id == value:
            return index
    return -1

def rehearsal_gate_index(bundle: ArchitectureRehearsalBundle, value: String) -> Int:
    for index in range(len(bundle.gate_rehearsals)):
        if bundle.gate_rehearsals[index].gate_suite_id == value:
            return index
    return -1

def rehearsal_cover_index(bundle: ArchitectureRehearsalBundle, value: String) -> Int:
    for index in range(len(bundle.covers)):
        if bundle.covers[index].cover_id == value:
            return index
    return -1

def rehearsal_wave_move_count(bundle: ArchitectureRehearsalBundle, wave_id: String) -> Int:
    var count = 0
    for index in range(len(bundle.moves)):
        if bundle.moves[index].wave_id == wave_id:
            count += 1
    return count

def rehearsal_snapshot_validation_passed(bundle: ArchitectureRehearsalBundle) -> Bool:
    return (
        bundle.validation.status == "passed"
        and len(bundle.validation.missing_migration_steps) == 0
        and len(bundle.validation.rehearsals_without_gate_suite) == 0
        and len(bundle.validation.open_sets_without_cover) == 0
        and len(bundle.validation.unknown_diagrams) == 0
        and len(bundle.validation.unknown_laws) == 0
        and len(bundle.validation.unknown_natural_transformations) == 0
        and len(bundle.validation.gate_suites_with_missing_commands) == 0
    )

def rehearsal_runtime_validation_passed(bundle: ArchitectureRehearsalBundle) -> Bool:
    if len(bundle.moves) != len(bundle.gate_rehearsals):
        return False
    if len(bundle.open_sets) != len(bundle.covers):
        return False
    for move_index in range(len(bundle.moves)):
        var found_gate = False
        for gate_index in range(len(bundle.gate_rehearsals)):
            if bundle.gate_rehearsals[gate_index].step_id == bundle.moves[move_index].step_id:
                found_gate = True
                if bundle.gate_rehearsals[gate_index].status != "ready":
                    return False
                if len(bundle.gate_rehearsals[gate_index].preflight_commands) == 0:
                    return False
                if len(bundle.gate_rehearsals[gate_index].postflight_commands) == 0:
                    return False
                break
        if not found_gate or bundle.moves[move_index].status != "rehearsed":
            return False
    for open_index in range(len(bundle.open_sets)):
        var found_cover = False
        for cover_index in range(len(bundle.covers)):
            if bundle.covers[cover_index].open_set_id == bundle.open_sets[open_index].open_set_id:
                found_cover = True
                if bundle.covers[cover_index].status != "covered":
                    return False
                if len(bundle.covers[cover_index].moves) != len(bundle.covers[cover_index].gate_suites):
                    return False
                break
        if not found_cover:
            return False
    return rehearsal_snapshot_validation_passed(bundle)

def architecture_rehearsal_count_line(bundle: ArchitectureRehearsalBundle) -> String:
    return (
        "open_sets=" + String(len(bundle.open_sets))
        + " moves=" + String(len(bundle.moves))
        + " gate_rehearsals=" + String(len(bundle.gate_rehearsals))
        + " covers=" + String(len(bundle.covers))
    )

