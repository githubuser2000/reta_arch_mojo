"""Generated native Mojo representation of architecture_activation.
The Python reference is evaluated only during explicit regeneration; runtime
navigation and snapshot validation are fully native.
Regenerate with tools/generate_architecture_activation.py.
"""

from std.collections import List

@fieldwise_init
struct ActivationCommandSpec(Copyable):
    var name: String
    var command: String

@fieldwise_init
struct ActivationWindowSpec(Copyable):
    var window_id: String
    var wave_id: String
    var order: Int
    var open_set_id: String
    var owner_capsules: List[String]
    var activation_units: List[String]
    var basis: List[String]
    var topology_role: String
    var status: String

@fieldwise_init
struct ActivationUnitSpec(Copyable):
    var activation_id: String
    var move_id: String
    var step_id: String
    var wave_id: String
    var legacy_owner: String
    var target_owner: String
    var current_capsule: String
    var target_capsule: String
    var activation_kind: String
    var category: String
    var functors: List[String]
    var natural_transformations: List[String]
    var diagrams: List[String]
    var laws: List[String]
    var required_gates: List[String]
    var rehearsal_gate_suite: String
    var commit_strategy: String
    var rollback_strategy: String
    var observable_invariant: String
    var status: String

@fieldwise_init
struct ActivationGateSpec(Copyable):
    var activation_id: String
    var gate_suite_id: String
    var gates: List[String]
    var preflight_commands: List[ActivationCommandSpec]
    var commit_commands: List[ActivationCommandSpec]
    var postflight_commands: List[ActivationCommandSpec]
    var rollback_commands: List[ActivationCommandSpec]
    var command_parity_required: Bool
    var bound_diagrams: List[String]
    var status: String

@fieldwise_init
struct ActivationRollbackSpec(Copyable):
    var activation_id: String
    var rollback_anchor: String
    var rollback_commands: List[ActivationCommandSpec]
    var protected_diagrams: List[String]
    var protected_laws: List[String]
    var status: String

@fieldwise_init
struct ActivationTransactionSpec(Copyable):
    var transaction_id: String
    var window_id: String
    var wave_id: String
    var activation_units: List[String]
    var gate_suites: List[String]
    var rollback_sections: List[String]
    var commit_order: List[String]
    var gluing_operation: String
    var universal_property: String
    var status: String

@fieldwise_init
struct ActivationCheckSpec(Copyable):
    var name: String
    var status: String
    var failed_items: List[String]
    var checked_count: Int
    var reading: String

@fieldwise_init
struct ActivationValidationSpec(Copyable):
    var status: String
    var missing_rehearsal_moves: List[String]
    var activations_without_gate: List[String]
    var activations_without_rollback: List[String]
    var windows_without_transaction: List[String]
    var unknown_diagrams: List[String]
    var unknown_laws: List[String]
    var unknown_natural_transformations: List[String]
    var transactions_not_ready: List[String]
    var checks: List[ActivationCheckSpec]

@fieldwise_init
struct Stage36ArchitecturePlan(Copyable):
    var planned_after_stage_35: List[String]
    var implemented_in_stage_36: List[String]
    var inherited_from_previous_stages: List[String]
    var behaviour_change: String

@fieldwise_init
struct ArchitectureActivationBundle(Copyable):
    var windows: List[ActivationWindowSpec]
    var units: List[ActivationUnitSpec]
    var gates: List[ActivationGateSpec]
    var rollbacks: List[ActivationRollbackSpec]
    var transactions: List[ActivationTransactionSpec]
    var validation: ActivationValidationSpec
    var text_diagram: String
    var mermaid_diagram: String
    var plan: Stage36ArchitecturePlan

def activation_window_index(bundle: ArchitectureActivationBundle, value: String) -> Int:
    for index in range(len(bundle.windows)):
        if bundle.windows[index].window_id == value:
            return index
    return -1

def activation_unit_index(bundle: ArchitectureActivationBundle, value: String) -> Int:
    for index in range(len(bundle.units)):
        if bundle.units[index].activation_id == value:
            return index
    return -1

def activation_move_index(bundle: ArchitectureActivationBundle, value: String) -> Int:
    for index in range(len(bundle.units)):
        if bundle.units[index].move_id == value:
            return index
    return -1

def activation_gate_index(bundle: ArchitectureActivationBundle, value: String) -> Int:
    for index in range(len(bundle.gates)):
        if bundle.gates[index].gate_suite_id == value:
            return index
    return -1

def activation_rollback_index(bundle: ArchitectureActivationBundle, value: String) -> Int:
    for index in range(len(bundle.rollbacks)):
        if bundle.rollbacks[index].activation_id == value:
            return index
    return -1

def activation_transaction_index(bundle: ArchitectureActivationBundle, value: String) -> Int:
    for index in range(len(bundle.transactions)):
        if bundle.transactions[index].transaction_id == value:
            return index
    return -1

def activation_wave_unit_count(bundle: ArchitectureActivationBundle, wave_id: String) -> Int:
    var count = 0
    for index in range(len(bundle.units)):
        if bundle.units[index].wave_id == wave_id:
            count += 1
    return count

def activation_snapshot_validation_passed(bundle: ArchitectureActivationBundle) -> Bool:
    return (
        bundle.validation.status == "passed"
        and len(bundle.validation.missing_rehearsal_moves) == 0
        and len(bundle.validation.activations_without_gate) == 0
        and len(bundle.validation.activations_without_rollback) == 0
        and len(bundle.validation.windows_without_transaction) == 0
        and len(bundle.validation.unknown_diagrams) == 0
        and len(bundle.validation.unknown_laws) == 0
        and len(bundle.validation.unknown_natural_transformations) == 0
        and len(bundle.validation.transactions_not_ready) == 0
    )

def activation_runtime_validation_passed(bundle: ArchitectureActivationBundle) -> Bool:
    if len(bundle.units) != len(bundle.gates) or len(bundle.units) != len(bundle.rollbacks):
        return False
    if len(bundle.windows) != len(bundle.transactions):
        return False
    for unit_index in range(len(bundle.units)):
        var found_gate = False
        var found_rollback = False
        for gate_index in range(len(bundle.gates)):
            if bundle.gates[gate_index].activation_id == bundle.units[unit_index].activation_id:
                found_gate = True
                if bundle.gates[gate_index].status != "commit_gated":
                    return False
                if len(bundle.gates[gate_index].commit_commands) == 0:
                    return False
                break
        for rollback_index in range(len(bundle.rollbacks)):
            if bundle.rollbacks[rollback_index].activation_id == bundle.units[unit_index].activation_id:
                found_rollback = True
                if bundle.rollbacks[rollback_index].status != "rollback_ready":
                    return False
                if len(bundle.rollbacks[rollback_index].rollback_commands) == 0:
                    return False
                break
        if not found_gate or not found_rollback or bundle.units[unit_index].status != "activation_ready":
            return False
    for window_index in range(len(bundle.windows)):
        var found_transaction = False
        for transaction_index in range(len(bundle.transactions)):
            if bundle.transactions[transaction_index].window_id == bundle.windows[window_index].window_id:
                found_transaction = True
                if bundle.transactions[transaction_index].status != "transaction_ready":
                    return False
                if len(bundle.transactions[transaction_index].activation_units) != len(bundle.transactions[transaction_index].gate_suites):
                    return False
                if len(bundle.transactions[transaction_index].activation_units) != len(bundle.transactions[transaction_index].rollback_sections):
                    return False
                break
        if not found_transaction:
            return False
    return activation_snapshot_validation_passed(bundle)

def architecture_activation_count_line(bundle: ArchitectureActivationBundle) -> String:
    return (
        "windows=" + String(len(bundle.windows))
        + " units=" + String(len(bundle.units))
        + " gates=" + String(len(bundle.gates))
        + " rollbacks=" + String(len(bundle.rollbacks))
        + " transactions=" + String(len(bundle.transactions))
    )

