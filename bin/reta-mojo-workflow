#!/usr/bin/env sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
TARGET=${RETA_WORKFLOW_BINARY:-"$ROOT/target/bin/reta-mojo-workflow"}
if [ ! -x "$TARGET" ]; then
    printf '%s\n' "Fehlendes Compilerziel: $TARGET" >&2
    printf '%s\n' 'Baue es mit scripts/build.sh.' >&2
    exit 127
fi
exec "$ROOT/bin/mojo-runtime-exec" "$TARGET" "$@"
