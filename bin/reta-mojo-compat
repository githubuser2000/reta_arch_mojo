#!/usr/bin/env sh
set -eu
SELF=$0
if command -v readlink >/dev/null 2>&1; then
    SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
fi
ROOT=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd)
# Preserve the historical PyPy3 reference for explicit Python/math commands
# and for the atomic compatibility child process.
if [ -z "${RETA_PYTHON-}" ]; then
    RETA_PYTHON=$(RETA_PROJECT_ROOT="$ROOT" "$ROOT/scripts/select_reference_python.sh")
    export RETA_PYTHON
fi
cd "$ROOT"
if [ -x "$ROOT/target/bin/reta-mojo-compat-bin" ]; then
    exec "$ROOT/bin/mojo-runtime-exec" "$ROOT/target/bin/reta-mojo-compat-bin" "$@"
fi
exec "$ROOT/bin/mojo-real" run "$ROOT/src/compat_main.mojo" "$@"
