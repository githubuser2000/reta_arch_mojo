def _semantic_flat_table(
    output_mode: str,
    data: bytes,
) -> tuple[tuple[str, ...], ...]:
    # Reconstruct logical table rows from wrapped CSV/Markdown/Emacs output.
    import csv as csv_module

    text = (
        data.decode("utf-8")
        .replace("\r\n", "\n")
        .replace("\r", "\n")
    )
    logical_rows: list[dict[str, object]] = []

    for line_number, raw_line in enumerate(text.splitlines(), start=1):
        if not raw_line.strip():
            continue

        if output_mode == "csv":
            cells = next(
                csv_module.reader(
                    [raw_line],
                    delimiter=";",
                    quotechar='"',
                )
            )
        else:
            stripped = raw_line.strip()

            # Markdown-/Emacs-Trennzeilen tragen keine Zellinhalte.
            if re.fullmatch(r"[|+\-: ]+", stripped):
                continue

            cells = stripped.split("|")
            if cells and cells[0] == "":
                cells = cells[1:]
            if cells and cells[-1] == "":
                cells = cells[:-1]

        assert len(cells) >= 2, (
            f"{output_mode} line {line_number} has too few cells: "
            f"{raw_line!r}"
        )

        structural = tuple(
            _without_whitespace(cell)
            for cell in cells[:2]
        )

        # Die zweite Strukturspalte ist die eigentliche Zeilennummer.
        # Die erste Zählspalte kann auf Fortsetzungszeilen wiederholt werden
        # und darf deshalb allein keine neue logische Datenzeile beginnen.
        row_marker = structural[1]
        starts_new_row = not logical_rows or bool(row_marker)

        if starts_new_row:
            logical_rows.append(
                {
                    "structural": list(structural),
                    "columns": [""] * len(cells),
                }
            )

        columns = logical_rows[-1]["columns"]
        assert isinstance(columns, list)
        assert len(columns) == len(cells), (
            f"{output_mode} column count changed on line {line_number}: "
            f"{len(columns)} != {len(cells)}"
        )

        for column_index, cell in enumerate(cells):
            fragment = _without_whitespace(cell)

            if column_index < 2:
                existing = str(columns[column_index])
                if fragment:
                    if existing:
                        assert existing == fragment, (
                            f"{output_mode} structural column changed on "
                            f"line {line_number}: {existing!r} != {fragment!r}"
                        )
                    else:
                        columns[column_index] = fragment
            else:
                columns[column_index] += fragment

    assert logical_rows
    return tuple(
        tuple(str(column) for column in row["columns"])
        for row in logical_rows
    )


